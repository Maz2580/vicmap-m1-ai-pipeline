# Normalize line endings on commit; checkout in OS-native style.
# Stops the CRLF warning noise on Windows and keeps the repo LF-only.
* text=auto eol=lf

# Force LF on shell / config files even on Windows.
*.sh         text eol=lf
*.py         text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.cfg        text eol=lf
*.ini        text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# Force CRLF on Windows-only scripts.
*.bat        text eol=crlf
*.ps1        text eol=crlf

# Treat data + binary assets as binary.
*.csv        binary
*.xlsx       binary
*.docx       binary
*.pdf        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.shp        binary
*.shx        binary
*.dbf        binary
*.prj        binary
*.cpg        binary
