# =============================================================================
# vicmap-m1-ai-pipeline — environment template
# =============================================================================
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# All placeholders below are deliberately invalid so the app errors loudly if
# you forget to configure something.
# =============================================================================

# --- Your council's Victorian LGA code ---------------------------------------
# 3-digit code, e.g. 346 = Greater Shepparton, 300 = Alpine.
# See https://www.land.vic.gov.au/maps-and-spatial/ for the full list.
LGA_CODE=

# --- TechnologyOne InfoProd SQL Server ---------------------------------------
# All 4 values must be set. Defaults are empty so the connection fails loudly.
DB_SERVER=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=InfoProd

# --- AI Validation API -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=5001
VALIDATION_API_URL=http://localhost:5001

# --- LLM providers -----------------------------------------------------------
# At least one of these must be set, depending on which provider you select.
# Provider selection happens via the LLM_PROVIDER env var (openai | openrouter
# | anthropic | ollama).
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# For Ollama, point at your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# --- IMAP email monitoring (VicMap delivery notifications) -------------------
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-imap-app-password
EMAIL_SERVER=outlook.office365.com
EMAIL_PORT=993

# --- Geocortex / Pozi viewer -------------------------------------------------
# Used for opening properties in the council's spatial viewer. Leave blank if
# unused — the corresponding UI buttons will be disabled.
GEOCORTEX_URL=
GEOCORTEX_USER=
GEOCORTEX_PASS=

# --- FME (Feature Manipulation Engine) ---------------------------------------
# Required only if you use the FME phase of the pipeline.
M1_FME_EXE=
M1_FME_WORKSPACE=

# --- Pozi Connect ------------------------------------------------------------
# Path to your Pozi Connect installation directory.
M1_POZI_DIR=

# --- File paths --------------------------------------------------------------
M1_LOG_DIR=logs
M1_RATES_DB_CSV=data/rates/rates_export.csv
M1_QA_REPORT=reports/m1_qa.csv

# --- Sample data path (for demo scripts) -------------------------------------
# Override only if your test fixture lives somewhere else.
SAMPLE_M1_CSV=tests/fixtures/sample_m1.csv
